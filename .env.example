# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TINYFISH_API_KEY: Recommended for live TinyFish public-web research.
# Obtain a key from the official TinyFish developer platform: https://agent.tinyfish.ai/api-keys
# When configured, ScamShield AI sends GET requests to the official Search API (https://api.search.tinyfish.ai)
# and POST requests to the Fetch API (https://api.fetch.tinyfish.ai) with the 'X-API-Key' header.
# When omitted, the app honestly reports this status and uses server-side Gemini Search grounding as a fallback.
TINYFISH_API_KEY=""

# Optional endpoint overrides (defaults to official TinyFish production endpoints):
# TINYFISH_SEARCH_URL="https://api.search.tinyfish.ai"
# TINYFISH_FETCH_URL="https://api.fetch.tinyfish.ai"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
